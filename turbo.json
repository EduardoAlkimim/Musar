{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "@escola/db#generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build",
        "@escola/db#generate"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "@escola/db#generate"
      ]
    },
    "lint": {},
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "build"
      ]
    },
    "@escola/db#generate": {
      "cache": false,
      "outputs": [
        "src/generated/**"
      ]
    }
  }
}