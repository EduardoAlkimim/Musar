{
  "name": "@escola/db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "validate": "prisma validate",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "rls": "tsx src/aplicar-rls.ts",
    "seed": "tsx src/seed-cli.ts",
    "typecheck": "tsc --noEmit",
    "preparar": "prisma migrate deploy && tsx src/aplicar-rls.ts && tsx src/seed-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@escola/domain": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.23.1"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  }
}