// Modelo de dados da plataforma. Toda tabela tem school_id: isolamento por escola
// garantido também no banco por Row Level Security (ver prisma/rls.sql).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  previewFeatures = ["postgresqlExtensions"]
  moduleFormat    = "cjs"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Papel {
  ALUNO
  PROFESSOR
  PROFESSOR_REFORCO
  COORDENADOR
  RESPONSAVEL
  ADMIN
}

enum Turno {
  MANHA
  TARDE
  NOITE
  INTEGRAL
}

enum TipoAvaliacao {
  PROVA
  SIMULADO
  TAREFA
  MINI_AVALIACAO
}

enum StatusAlerta {
  ABERTO
  ENCAMINHADO
  RESOLVIDO
  DESCARTADO
}

enum StatusReforco {
  AGUARDANDO_RESPONSAVEL
  APROVADO
  RECUSADO
  EM_ANDAMENTO
  CONCLUIDO
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  plano     String   @default("piloto")
  createdAt DateTime @default(now()) @map("created_at")

  usuarios   Membership[]
  turmas     SchoolClass[]
  materias   Subject[]
  avaliacoes Assessment[]

  @@map("school")
}

/// Identidade global. keycloakId é preenchido no primeiro login (casando pelo e-mail);
/// alunos pequenos podem existir sem conta de acesso. Papéis valem por escola, em Membership.
model User {
  id             String    @id @default(uuid()) @db.Uuid
  keycloakId     String?   @unique @map("keycloak_id")
  nome           String
  email          String    @unique
  dataNascimento DateTime? @map("data_nascimento") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")

  vinculos Membership[]

  @@map("user")
}

/// Um usuário pode ter vários papéis na mesma escola (ex.: professor que também dá reforço).
model Membership {
  id       String  @id @default(uuid()) @db.Uuid
  schoolId String  @map("school_id") @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  papeis   Papel[]
  ativo    Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([userId])
  @@map("membership")
}

model SchoolClass {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  nome      String
  serie     String
  anoLetivo Int    @map("ano_letivo")
  turno     Turno

  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  matriculas Enrollment[]
  materias   ClassSubject[]

  @@unique([schoolId, nome, anoLetivo])
  @@map("class")
}

model Enrollment {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  classId   String @map("class_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  turma SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([schoolId, studentId])
  @@map("enrollment")
}

model Subject {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  nome     String

  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  habilidades Skill[]
  turmas      ClassSubject[]

  @@unique([schoolId, nome])
  @@map("subject")
}

/// Turma + matéria + professor. Avaliações e alertas apontam para cá.
model ClassSubject {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  classId   String @map("class_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid
  teacherId String @map("teacher_id") @db.Uuid

  turma      SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  materia    Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  avaliacoes Assessment[]

  @@unique([classId, subjectId])
  @@map("class_subject")
}

/// Habilidade da BNCC. Código oficial, ex.: EF06MA07.
model Skill {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid
  codigo    String
  descricao String
  nomeCurto String @map("nome_curto")

  materia Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([schoolId, codigo])
  @@map("skill")
}

model Assessment {
  id             String        @id @default(uuid()) @db.Uuid
  schoolId       String        @map("school_id") @db.Uuid
  classSubjectId String        @map("class_subject_id") @db.Uuid
  titulo         String
  data           DateTime      @db.Date
  tipo           TipoAvaliacao

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  questoes     Question[]

  @@index([schoolId, classSubjectId, data])
  @@map("assessment")
}

model Question {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  numero       Int
  enunciado    String
  alternativas String[]
  gabarito     Int
  skillId      String   @map("skill_id") @db.Uuid
  /// Índice da alternativa → confusão que ela revela.
  distratores  Json?

  avaliacao Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  respostas Answer[]

  @@unique([assessmentId, numero])
  @@map("question")
}

model Answer {
  id         String @id @default(uuid()) @db.Uuid
  schoolId   String @map("school_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  studentId  String @map("student_id") @db.Uuid
  marcada    Int?
  tempoSeg   Int?   @map("tempo_seg")

  questao Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, studentId])
  @@index([schoolId, studentId])
  @@map("answer")
}

/// Domínio 0–100 por aluno e habilidade, recalculado a cada avaliação.
model Mastery {
  schoolId  String   @map("school_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  nivel     Int
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([studentId, skillId])
  @@index([schoolId, skillId])
  @@map("mastery")
}

model Alert {
  id        String       @id @default(uuid()) @db.Uuid
  schoolId  String       @map("school_id") @db.Uuid
  studentId String       @map("student_id") @db.Uuid
  skillId   String       @map("skill_id") @db.Uuid
  score     Int
  frase     String
  /// "Por que estou vendo isso": os dados que geraram o alerta.
  motivos   Json
  status    StatusAlerta @default(ABERTO)
  createdAt DateTime     @default(now()) @map("created_at")

  reforcos TutoringRequest[]

  @@index([schoolId, status])
  @@map("alert")
}

model TutoringRequest {
  id          String        @id @default(uuid()) @db.Uuid
  schoolId    String        @map("school_id") @db.Uuid
  alertId     String        @map("alert_id") @db.Uuid
  tutorId     String        @map("tutor_id") @db.Uuid
  pedidoPor   String        @map("pedido_por") @db.Uuid
  plano       Json
  status      StatusReforco @default(AGUARDANDO_RESPONSAVEL)
  aprovadoPor String?       @map("aprovado_por") @db.Uuid
  aprovadoEm  DateTime?     @map("aprovado_em")
  createdAt   DateTime      @default(now()) @map("created_at")

  alerta  Alert             @relation(fields: [alertId], references: [id])
  sessoes TutoringSession[]

  @@index([schoolId, tutorId, status])
  @@map("tutoring_request")
}

model TutoringSession {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  inicio    DateTime
  modo      String
  registro  String?

  pedido TutoringRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("tutoring_session")
}

/// Responsável × aluno, com o consentimento LGPD (art. 14) registrado.
model GuardianLink {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  guardianId      String    @map("guardian_id") @db.Uuid
  studentId       String    @map("student_id") @db.Uuid
  consentimentoEm DateTime? @map("consentimento_em")
  versaoTermo     String?   @map("versao_termo")

  @@unique([guardianId, studentId])
  @@map("guardian_link")
}

model Material {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  classSubjectId String   @map("class_subject_id") @db.Uuid
  titulo         String
  arquivoS3      String   @map("arquivo_s3")
  createdAt      DateTime @default(now()) @map("created_at")

  trechos Chunk[]

  @@map("material")
}

/// Trecho do material com embedding: base do assistente da aula (RAG com citação).
model Chunk {
  id         String                       @id @default(uuid()) @db.Uuid
  schoolId   String                       @map("school_id") @db.Uuid
  materialId String                       @map("material_id") @db.Uuid
  texto      String
  pagina     Int?
  embedding  Unsupported("vector(1024)")?

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([schoolId, materialId])
  @@map("chunk")
}

model Incentive {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  meta     String
  premio   String
  alvoTipo String @map("alvo_tipo")
  alvoId   String @map("alvo_id") @db.Uuid

  @@map("incentive")
}

/// Log de acesso: quem viu qual aluno e quando (LGPD).
model AccessLog {
  id        BigInt   @id @default(autoincrement())
  schoolId  String   @map("school_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  studentId String?  @map("student_id") @db.Uuid
  acao      String
  em        DateTime @default(now())

  @@index([schoolId, studentId, em])
  @@map("access_log")
}

/// Perfil do professor de reforço: base do matching (especialidade × agenda × histórico).
model TutorProfile {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  especialidades String[]
  /// Horários livres na semana, ex.: "ter 14:00".
  horarios       String[]
  modo           String   @default("presencial")
  /// Por habilidade: { "EF06MA07": { "closed": 17, "total": 19 } }
  historico      Json     @default("{}")

  @@unique([schoolId, userId])
  @@map("tutor_profile")
}

model Attendance {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  data      DateTime @db.Date
  presente  Boolean

  @@unique([classId, studentId, data])
  @@index([schoolId, studentId, data])
  @@map("attendance")
}

/// Mensagem entre família e professor, sempre sobre um aluno.
model Message {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  fromUserId String    @map("from_user_id") @db.Uuid
  toUserId   String    @map("to_user_id") @db.Uuid
  studentId  String    @map("student_id") @db.Uuid
  texto      String
  lidaEm     DateTime? @map("lida_em")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([schoolId, toUserId, createdAt])
  @@map("message")
}
