# Copie para .env.local (não versionado).
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api
KEYCLOAK_ISSUER=http://localhost:8080/realms/musar
KEYCLOAK_CLIENT_ID=musar-web
KEYCLOAK_CLIENT_SECRET=musar-web-local
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Mostra as contas de teste na página de entrada (só para a sua máquina).
MOSTRAR_CONTAS_DE_TESTE=1

# Demonstração guiada em /demo (só na sua máquina; nunca em produção).
DEMO_MODE=1
