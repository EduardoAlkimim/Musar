# API (apps/api). Os valores abaixo já são os padrões locais.
DATABASE_URL=postgresql://escola:escola@localhost:5442/escola
DATABASE_URL_APP=postgresql://escola_app:escola_app@localhost:5442/escola
KEYCLOAK_ISSUER=http://localhost:8080/realms/trilha
KEYCLOAK_CLIENT_ID=trilha-web
REDIS_URL=redis://localhost:6379
# Camada de IA (AWS Bedrock). Trocar o modelo é só mudar estas variáveis.
AWS_REGION=sa-east-1
LLM_MODEL_SIMPLE=deepseek.v3-2
LLM_MODEL_CHAT=deepseek.v3-2
LLM_FALLBACK_MODEL=qwen.qwen3-32b
