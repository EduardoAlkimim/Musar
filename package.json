{
  "name": "plataforma-escolar",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "preparar": "docker compose up -d && pnpm --filter @escola/db preparar",
    "dev": "turbo run dev --filter=@escola/web --filter=@escola/api",
    "build": "turbo run build",
    "start": "pnpm --filter @escola/db exec tsx src/aplicar-rls.ts && turbo run start --filter=@escola/web --filter=@escola/api",
    "seed": "pnpm --filter @escola/db seed",
    "test": "turbo run test",
    "test:e2e": "cross-env E2E=1 pnpm --filter @escola/api test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}